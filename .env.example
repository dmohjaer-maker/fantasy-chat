# ── Bots ─────────────────────────────────────────────
BOT_TOKEN=123456:ABC-your-main-bot-token
ADMIN_BOT_TOKEN=123456:ABC-your-admin-bot-token

# Comma separated Telegram user IDs allowed in admin bot
ADMIN_IDS=111111111,222222222

# ── PostgreSQL ───────────────────────────────────────
# local: postgresql://fantasy:fantasy@localhost:5432/fantasy_chat
POSTGRES_DSN=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# ── Redis ───────────────────────────────────────────
# local: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# ── App ─────────────────────────────────────────────
ENV=development            # development | production
LOG_LEVEL=INFO
HEALTH_PORT=8080           # HTTP health check port

# ── Defaults (overridable from Admin settings) ──────
MIN_AGE=18
MESSAGE_RATE_LIMIT=10      # messages per window
RATE_LIMIT_WINDOW_SEC=10
MEDIA_RETENTION_DAYS=7
